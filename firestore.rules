rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Documento único por usuario: users/{uid} con dos mapas: cfg y sets.
    match /users/{uid} {

      // El dueño puede leer lo suyo.
      allow read: if request.auth != null && request.auth.uid == uid;

      // Escritura (crear/actualizar) validada:
      //  - solo el dueño
      //  - solo los campos permitidos (cfg, sets), nada más
      //  - cfg y sets deben ser mapas y con un tope de tamaño (anti-abuso)
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['cfg', 'sets', 'custom', 'log', 'days'])
        && (!('cfg' in request.resource.data)
            || (request.resource.data.cfg is map && request.resource.data.cfg.size() <= 500))
        && (!('sets' in request.resource.data)
            || (request.resource.data.sets is map && request.resource.data.sets.size() <= 3000))
        && (!('custom' in request.resource.data)
            || (request.resource.data.custom is map && request.resource.data.custom.size() <= 200))
        && (!('log' in request.resource.data)
            || (request.resource.data.log is list && request.resource.data.log.size() <= 5000))
        && (!('days' in request.resource.data)
            || (request.resource.data.days is list && request.resource.data.days.size() <= 30));

      // No permitimos borrar el documento desde el cliente.
      allow delete: if false;
    }

    // Todo lo demás, bloqueado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
